# Copy this file to .env on the machine that runs SAF, then fill in local
# values.

# Runtime paths. /opt/saf is the documentation default; change it if you deploy
# somewhere else.
SAF_RUNTIME=rust
SAF_RUST_BIN=/opt/saf/bin/saf
# SAF_CONFIG_FILE=/opt/saf/config.json5

# Rust live account scope. Keep SAF_ONLY_IGNS to one account for first live
# smoke/acceptance runs, then widen it after the dry-run path is healthy.
SAF_ONLY_IGNS=
SAF_DEFAULT_IGN=
SAF_START_DEFAULT_ONLY=1
SAF_LIVE_SMOKE_IGN=
# Set to azalea only after Microsoft auth is ready for live Minecraft runs.
SAF_RUST_MINECRAFT=

# Discord slash-command gateway.
SAF_DISCORD_BOT_ENABLED=1
SAF_DISCORD_TOKEN=
SAF_DISCORD_CLIENT_ID=
SAF_DISCORD_GUILD_ID=
SAF_DISCORD_ALLOWED_IDS=
SAF_EXTERNAL_BACKEND_ENABLED=0

# SkyCofl live socket auth. Use either a global session or an account-specific
# socket override that already includes an SId query value.
SAF_COFL_SESSION=
SAF_LIVE_SMOKE_COFL_SESSION=
# SAF_COFL_SOCKET_MAINACCOUNT=wss://sky.coflnet.com/modsocket?SId=<cofl-session>

# Optional live smoke override when the acceptance run should use a separate
# config file instead of config.json5.
# SAF_LIVE_SMOKE_CONFIG=/opt/saf/config.json5
