# Copy to .env and fill in. Used by docker-compose.yml.

# Port to expose the dashboard on (browser → http://localhost:<WEB_PORT>).
WEB_PORT=8090

# Login password for the dashboard. Leave blank only on a trusted/loopback
# network. A long passphrase is recommended.
DASHBOARD_PASSWORD=change-me

# Optional fixed secret for signing session cookies (random per restart if blank).
SESSION_SECRET=

# Bearer token for the bot API — the value printed by
# scripts/setup-dashboard-api.sh on the bot host.
BOT_API_TOKEN=

# --- Upstream: pick ONE ---
# A) Direct URL (bot API reachable from the container):
#    same host + Docker Desktop:  http://host.docker.internal:8787
#    same host + Linux host net:  http://127.0.0.1:8787  (run with network_mode: host)
BOT_API_URL=

# B) SSH tunnel (gateway opens it; mount the key via docker-compose volumes):
SSH_DEST=
SSH_PORT=
SSH_KEY=
REMOTE_PORT=8787
